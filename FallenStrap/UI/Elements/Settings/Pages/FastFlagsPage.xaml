<ui:UiPage x:Class="FallenStrap.UI.Elements.Settings.Pages.FastFlagsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:models="clr-namespace:FallenStrap.UI.ViewModels"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:resources="clr-namespace:FallenStrap.Resources"
      xmlns:controls="clr-namespace:FallenStrap.UI.Elements.Controls"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      xmlns:flagpresets="clr-namespace:FallenStrap.Enums.FlagPresets"
      mc:Ignorable="d"
      d:DesignHeight="1500" d:DesignWidth="800"
      Title="FastFlagsPage"
      Scrollable="True"
      Loaded="Page_Loaded">
    <ui:UiPage.Resources>
        <ObjectDataProvider x:Key="RenderingBackendValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="flagpresets:RenderingBackend" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </ui:UiPage.Resources>
    <StackPanel Margin="0,0,14,14">
        <TextBlock Margin="0,0,0,16" Text="{x:Static resources:Strings.Menu_FastFlags_Description}" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <controls:OptionControl 
            Header="{x:Static resources:Strings.Menu_FastFlags_ManagerEnabled_Title}"
            Description="{x:Static resources:Strings.Menu_FastFlags_ManagerEnabled_Description}">
            <ui:ToggleSwitch IsChecked="{Binding UseFastFlagManager, Mode=TwoWay}" />
        </controls:OptionControl>

        <TextBlock Text="{x:Static resources:Strings.Common_Presets}" FontSize="20" FontWeight="Medium" Margin="0,16,0,0" />

        <TextBlock Text="{x:Static resources:Strings.Menu_FastFlags_Presets_Categories_Rendering}" FontSize="16" FontWeight="Medium" Margin="0,16,0,0" />
        <controls:MarkdownTextBlock MarkdownText="{Binding Source={x:Static resources:Strings.Menu_FastFlags_Presets_D3DExclusiveFullscreenInfo}, Converter={StaticResource StringFormatConverter}, ConverterParameter='https://fallenstraplabs.com/wiki/features/engine-settings/#exclusive-fullscreen'}"  Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <controls:OptionControl 
            Header="{x:Static resources:Strings.Menu_FastFlags_Presets_MSAA_Title}">
            <ComboBox Margin="5,0,0,0" Padding="10,5,10,5" Width="200" ItemsSource="{Binding MSAALevels.Keys, Mode=OneTime}" Text="{Binding SelectedMSAALevel, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </controls:OptionControl>

        <controls:OptionControl 
            Header="{x:Static resources:Strings.Menu_FastFlags_Presets_FixDisplayScaling_Title}" 
            Description="{x:Static resources:Strings.Menu_FastFlags_Presets_FixDisplayScaling_Description}" 
            HelpLink="https://fallenstraplabs.com/wiki/features/engine-settings/#preserving-rendering-quality">
            <ui:ToggleSwitch IsChecked="{Binding FixDisplayScaling, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl 
            Header="{x:Static resources:Strings.Menu_FastFlags_Presets_TextureQuality_Title}">
            <ComboBox Margin="5,0,0,0" Padding="10,5,10,5" Width="200" ItemsSource="{Binding TextureQualities.Keys, Mode=OneTime}" Text="{Binding SelectedTextureQuality, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </controls:OptionControl>

        <controls:OptionControl 
            Header="Rendering Mode"
            Description="Configura la API de renderizado usada por Roblox.">
            <ComboBox Margin="5,0,0,0" Padding="10,5,10,5" Width="200" ItemsSource="{Binding Source={StaticResource RenderingBackendValues}}" SelectedItem="{Binding SelectedRenderingBackend, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </controls:OptionControl>

        <controls:OptionControl 
            Header="Override Graphics Quality Level"
            Description="Fuerza la calidad de graficos a un nivel especifico (1-10), similar al slider de graficos de Roblox pero mas preciso.">
            <ComboBox Margin="5,0,0,0" Padding="10,5,10,5" Width="200" ItemsSource="{Binding GraphicsQualityLevels.Keys, Mode=OneTime}" Text="{Binding SelectedGraphicsQualityLevel, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl 
            Header="Meshes Details"
            Description="Normal = comportamiento por defecto. Reducido/Minimo bajan la distancia a la que las mallas pierden detalle (mejor rendimiento en PC de gama baja).">
            <ComboBox Margin="5,0,0,0" Padding="10,5,10,5" Width="160" SelectedIndex="{Binding MeshDetailsLevel, Mode=TwoWay}">
                <ComboBoxItem Content="Normal" />
                <ComboBoxItem Content="Reducido" />
                <ComboBoxItem Content="Minimo" />
            </ComboBox>
        </controls:OptionControl>

        <controls:OptionControl 
            Header="Quitar sombras"
            Description="Elimina las sombras dinamicas del juego. Mejora bastante el rendimiento en PC de gama baja.">
            <ui:ToggleSwitch IsChecked="{Binding RemoveShadows, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl 
            Header="Pausar Voxelizer / Quitar sombras horneadas"
            Description="Desactiva el sistema de sombras horneadas (baked shadows) de Roblox. Mejora el rendimiento pero puede causar mapas muy claros u oscuros en algunos juegos.">
            <ui:ToggleSwitch IsChecked="{Binding PauseVoxelizer, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl 
            Header="Desactivar efectos de post-procesado"
            Description="Quita bloom, correccion de color y otros efectos visuales de postprocesado. Mejora el rendimiento, pero el juego se ve mas plano.">
            <ui:ToggleSwitch IsChecked="{Binding DisablePostFx, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl 
            Header="Desactivar anuncios"
            Description="Intenta desactivar los anuncios en juego (billboards publicitarios). No siempre funciona en todos los juegos.">
            <ui:ToggleSwitch IsChecked="{Binding DisableAds, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl 
            Header="Buffer de fotogramas reducido"
            Description="Reduce el tamano del frame buffer para mejor rendimiento en PC de gama baja. Puede introducir un poco mas de input lag.">
            <ui:ToggleSwitch IsChecked="{Binding LowFrameBuffer, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl 
            Header="Desactivar compositor de texturas en segundo plano"
            Description="Reduce el uso de CPU en segundo plano al cargar texturas. Recomendado para PC con pocos nucleos/hilos.">
            <ui:ToggleSwitch IsChecked="{Binding DisableTextureCompositor, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl 
            Header="Terreno de baja calidad"
            Description="Reduce la resolucion de las texturas del terreno (Terrain) para mejor rendimiento.">
            <ui:ToggleSwitch IsChecked="{Binding LowQualityTerrain, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl 
            Header="Modo de rendimiento (Perf Mode)"
            Description="Activa un modo de renderizado especial de Roblox pensado para equipos de gama muy baja.">
            <ui:ToggleSwitch IsChecked="{Binding PerfMode, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl 
            Header="Saltar niveles de detalle de texturas"
            Description="Carga las texturas con menos nitidez a cambio de mas FPS y menor uso de memoria.">
            <ui:ToggleSwitch IsChecked="{Binding SkipMipmaps, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl 
            Header="Reducir actualizaciones de luces dinamicas"
            Description="Limita cuantas luces dinamicas se actualizan por fotograma. Menos carga de CPU/GPU en juegos con mucha iluminacion.">
            <ui:ToggleSwitch IsChecked="{Binding ReduceLightUpdates, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl 
            Header="Desbloqueador de FPS"
            Description="Escribe el limite maximo de FPS deseado (ej. 144, 240). Dejalo vacio para usar el limite normal de Roblox (60).">
            <TextBox Width="120" Padding="10,5,10,5" Text="{Binding FpsLimit, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
        </controls:OptionControl>

        <controls:OptionControl 
            Header="Gray Sky"
            Description="Reemplaza el cielo del juego con un color gris solido. Puede no funcionar en todos los juegos.">
            <ui:ToggleSwitch IsChecked="{Binding GraySky, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl 
            Header="Disable Grass"
            Description="Elimina las texturas de pasto por defecto de Roblox.">
            <ui:ToggleSwitch IsChecked="{Binding DisableGrass, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl 
            Margin="0,24,0,0"
            Header="{x:Static resources:Strings.Menu_FastFlags_Reset_Title}">
            <ui:ToggleSwitch IsChecked="{Binding ResetConfiguration, Mode=TwoWay}" />
        </controls:OptionControl>

        <ui:CardAction Margin="0,8,0,0" Icon="EditSettings24" Command="{Binding OpenFastFlagEditorCommand}" Visibility="{Binding CanShowFastFlagEditor}">
            <StackPanel>
                <TextBlock FontSize="14" Text="{x:Static resources:Strings.Menu_FastFlagEditor_Title}" />
                <TextBlock Margin="0,2,0,0" FontSize="12" Text="{x:Static resources:Strings.Menu_FastFlags_Editor_Description}" Padding="0,0,16,0"  Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </ui:CardAction>
    </StackPanel>
</ui:UiPage>
